rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function ownerUid() { return 'jJPB9z2WISN7yhW1iq99H4ncfi72'; }
    function isOwner()  { return request.auth != null && request.auth.uid == ownerUid(); }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function withinSize() { return request.resource.size < 5 * 1024 * 1024; }
    function isVideo() { return request.resource.contentType.matches('video/(mp4|webm)'); }
    function withinVideoSize() { return request.resource.size < 25 * 1024 * 1024; }

    match /reviews/{uid}/{reviewId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && resource == null
                    && ((isImage() && withinSize()) || (isVideo() && withinVideoSize()));
      allow update: if false;
      allow delete: if isOwner() || (request.auth != null && request.auth.uid == uid);
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isImage() && withinSize();
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && isImage()
                   && request.resource.size < 2 * 1024 * 1024;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
