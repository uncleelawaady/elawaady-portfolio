rules_version = '2';

/* ===========================================================================
   Firebase Storage — مقفول بالكامل ما عدا مجلد المالك.
   ===========================================================================
   التطبيق مابيرفعش أي حاجة هنا خالص. صور الإثبات وصور البروفايل بتروح
   Cloudinary لأن Storage محتاج خطة Blaze.

   الملف باقي عشان أي مسار قديم أو أي محاولة رفع تفضل مرفوضة صراحةً، مش
   عشان الاعتماد الافتراضي يبقى هو اللي شغال.
=========================================================================== */
service firebase.storage {
  match /b/{bucket}/o {
    function ownerUid() { return 'jJPB9z2WISN7yhW1iq99H4ncfi72'; }
    function isOwner()  { return request.auth != null && request.auth.uid == ownerUid(); }
    function isImage()  { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function withinSize() { return request.resource.size < 5 * 1024 * 1024; }

    /* مجلد إداري للمالك بس — مش جزء من مسار التقييمات */
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isImage() && withinSize();
    }

    /* أي مسار تاني — بما فيه reviews/ وavatars/ القدام — مرفوض */
    match /{allPaths=**} { allow read, write: if false; }
  }
}
