rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownerUid() { return 'jJPB9z2WISN7yhW1iq99H4ncfi72'; }
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == ownerUid(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(allowed) { return changed().hasOnly(allowed); }

    match /content/portfolio { allow read: if true; allow write: if isOwner(); }
    match /content/draft { allow read, write: if isOwner(); }
    match /content_versions/{versionId} { allow read, create, delete: if isOwner(); allow update: if false; }
    match /sections/{sectionKey} { allow read: if true; allow write: if isOwner(); }
    match /settings/{docId} { allow read: if true; allow write: if isOwner(); }

    match /users/{uid} {
      function isSelf() { return signedIn() && request.auth.uid == uid; }
      function userEditableOnly() { return onlyChanged(['displayName','photoURL','bio','lastSeenAt','updatedAt']); }
      function userFieldsOnly() { return request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','bio','role','status','createdAt','updatedAt','lastSeenAt']); }
      allow read: if isSelf() || isOwner();
      allow create: if isSelf() && userFieldsOnly() && request.resource.data.role == 'user' && request.resource.data.status == 'active' && request.resource.data.uid == uid;
      allow update: if isOwner() || (isSelf() && userEditableOnly());
      allow delete: if isOwner();
    }

    match /reviews/{reviewId} {
      function isAuthor() { return signedIn() && resource.data.uid == request.auth.uid; }
      function reviewFieldsOnly() { return request.resource.data.keys().hasOnly(['uid','authorName','authorPhoto','rating','title','body','dealType','status','featured','imageCount','images','createdAt','updatedAt']); }
      function validNewReview() {
        let d = request.resource.data;
        return reviewFieldsOnly() && d.uid == request.auth.uid && d.status == 'pending' && d.featured == false && d.rating is int && d.rating >= 1 && d.rating <= 5 && d.title is string && d.title.size() <= 90 && d.body is string && d.body.size() >= 10 && d.body.size() <= 1500 && d.dealType in ['digital','design','development','marketing','consulting','mediation','project','trade','other','escrow','guarantee','transfer'] && !('moderatedBy' in d) && !('moderatedAt' in d);
      }
      function authorEditableOnly() { return onlyChanged(['title','body','rating','dealType','updatedAt']); }
      function mediaFieldsOnly() { return onlyChanged(['images','imageCount','updatedAt']); }
      allow read: if resource.data.status == 'approved' || isOwner() || isAuthor();
      allow create: if signedIn() && validNewReview();
      allow update: if isOwner() || (isAuthor() && resource.data.status == 'pending' && (authorEditableOnly() || mediaFieldsOnly()));
      allow delete: if isOwner() || (isAuthor() && resource.data.status == 'pending');
    }

    match /review_media/{mediaId} {
      function parent() { return get(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId)).data; }
      function existingParent() { return get(/databases/$(database)/documents/reviews/$(resource.data.reviewId)).data; }
      function mediaDocFieldsOnly() { return request.resource.data.keys().hasOnly(['url','publicId','mime','bytes','uid','reviewId','createdAt']); }
      function validMedia() { let d = request.resource.data; return mediaDocFieldsOnly() && d.url is string && d.url.matches('^https://.*') && d.publicId is string && d.publicId.size() > 0 && d.mime in ['image/jpeg','image/png','image/webp'] && d.bytes is int && d.bytes > 0 && d.bytes <= 5 * 1024 * 1024; }
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid) || existingParent().status == 'approved';
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && parent().uid == request.auth.uid && validMedia();
      allow update: if isOwner();
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid && existingParent().status == 'pending');
    }

    match /links/{linkId} {
      function validLink() { let d = request.resource.data; return d.title is string && d.title.size() > 0 && d.title.size() <= 120 && d.url is string && (d.url.matches('^https://.*') || d.url.matches('^http://.*')) && d.type in ['official','facebook_group','whatsapp_group','whatsapp_channel'] && d.order is number && d.visible is bool; }
      allow read: if true;
      allow create, update: if isOwner() && validLink();
      allow delete: if isOwner();
    }

    match /media/{mediaId} { allow read: if true; allow write: if isOwner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
